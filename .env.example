# ─────────────────────────────────────────────────────────────
# Nexus Scanner — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────

# Your VirusTotal API key (free at https://www.virustotal.com/gui/join-us)
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here


# ── Server ────────────────────────────────────────────────────

# Port the server listens on
PORT=3000

# Set to "production" on live servers
NODE_ENV=development


# ── Security ──────────────────────────────────────────────────

# Comma-separated list of allowed CORS origins.
# Leave blank to allow all (fine for local dev, restrict in production).
# Example: ALLOWED_ORIGINS=https://yourdomain.com,https://yourchatbot.com
ALLOWED_ORIGINS=
